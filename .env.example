# =============================================================================
# Django core
# =============================================================================
# CRITICAL: generate a new SECRET_KEY for production.
# Command: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-secure-random-key

# DEBUG — always False in production.
DJANGO_DEBUG=False

# Hostnames this app may serve (comma-separated).
# Example: yourdomain.com,www.yourdomain.com,app.onrender.com
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Django Sites framework ID
DJANGO_SITE_ID=1

# =============================================================================
# CSRF & security
# =============================================================================
# CSRF trusted origins (comma-separated HTTPS origins).
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: development with ngrok / localtunnel
NGROK_HOST=
TUNNEL_HOSTS=

# =============================================================================
# Database (MySQL)
# =============================================================================
MYSQL_DATABASE=silvershop
MYSQL_USER=root
MYSQL_PASSWORD=your-secure-database-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Connection max age in seconds (0 = disabled)
DB_CONN_MAX_AGE=0

# Atomic requests (True/False)
DB_ATOMIC_REQUESTS=False

# =============================================================================
# Stripe
# =============================================================================
# In production use LIVE keys (sk_live_... / pk_live_...).
# In development use TEST keys (sk_test_... / pk_test_...).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe webhook signing secret (Dashboard → Webhooks)
# Different for test vs live.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Cookie consent (GDPR-friendly): Meta / TikTok / GA load only after “Accept all”
# For local pixel testing without the banner: COOKIE_CONSENT_ENABLED=0
COOKIE_CONSENT_ENABLED=1

# =============================================================================
# Analytics & tracking
# =============================================================================
# Meta Pixel ID — https://business.facebook.com/events_manager
META_PIXEL_ID=1522970765464792
# ISO 4217 — must match store prices (ViewContent / Purchase)
META_PIXEL_CURRENCY=EUR

# TikTok Pixel (Ads Manager → Events → Web Events → Pixel ID)
TIKTOK_PIXEL_ID=
# Defaults to META_PIXEL_CURRENCY if unset
TIKTOK_PIXEL_CURRENCY=EUR

# Meta Conversions API (CAPI) — Purchase; same event_id as browser for deduplication
# Events Manager → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=
META_CAPI_GRAPH_VERSION=v21.0
# Optional: Events Manager → Test Events
# META_CAPI_TEST_EVENT_CODE=

# TikTok Events API — CompletePayment; Ads Manager → Events → server access token
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# Public site URL (no trailing slash) — CAPI event_source_url / TikTok page.url
# PUBLIC_BASE_URL=https://www.marbaras.com

# Google Analytics (GA4)
GOOGLE_ANALYTICS_ID=G-J2DV3RWZ8D

# =============================================================================
# Email
# =============================================================================
# In production prefer a transactional provider (SMTP below).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP — SendGrid example
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# Gmail example:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Mailgun example:
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-mailgun-username
# EMAIL_HOST_PASSWORD=your-mailgun-password

# Mailtrap (development):
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=your-mailtrap-user
# EMAIL_HOST_PASSWORD=your-mailtrap-password

EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=sales@marbaras.com
ADMIN_EMAIL=admin@marbaras.com

# =============================================================================
# Session & CSRF cookies
# =============================================================================
# Session max age in seconds (default 1209600 = 2 weeks)
SESSION_COOKIE_AGE=1209600
SESSION_SAVE_EVERY_REQUEST=False
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# CSRF cookie max age in seconds (default 31449600 ≈ 1 year)
CSRF_COOKIE_AGE=31449600

# =============================================================================
# File uploads
# =============================================================================
# Max in-memory upload size in bytes (default 2.5MB)
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# =============================================================================
# Security (production)
# =============================================================================
# SSL redirect (True/False; default True in production)
SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds
SECURE_HSTS_SECONDS=31536000

# Reverse proxy
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True

# =============================================================================
# Optional: Redis cache
# =============================================================================
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Optional: backups
# =============================================================================
# BACKUP_DIR=./backups
