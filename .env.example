# =============================================================================
# Django Core Settings
# =============================================================================
# ⚠️ КРИТИЧНО: Генерирай нов SECRET_KEY за production!
# Команда: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-secure-random-key

# DEBUG режим - ВИНАГИ False в production!
DJANGO_DEBUG=False

# Домейни на които приложението може да работи (разделени със запетая)
# Пример: yourdomain.com,www.yourdomain.com,app.onrender.com
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Django Sites Framework ID
DJANGO_SITE_ID=1

# =============================================================================
# CSRF & Security
# =============================================================================
# CSRF trusted origins (разделени със запетая)
# Пример: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Опционално: за development с ngrok/localtunnel
NGROK_HOST=
TUNNEL_HOSTS=

# =============================================================================
# Database (MySQL)
# =============================================================================
MYSQL_DATABASE=silvershop
MYSQL_USER=root
MYSQL_PASSWORD=your-secure-database-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Database connection pooling (секунди, 0 = disabled)
DB_CONN_MAX_AGE=0

# Atomic requests (True/False)
DB_ATOMIC_REQUESTS=False

# =============================================================================
# Stripe Payment Gateway
# =============================================================================
# ⚠️ В production използвай LIVE keys (sk_live_... и pk_live_...)
# В development използвай TEST keys (sk_test_... и pk_test_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Webhook Secret (от Stripe Dashboard → Webhooks)
# ⚠️ Различен за test и live режим!
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Cookie consent (GDPR-friendly): Meta / TikTok / GA load only after “Приемам всички”
# За локални тестове на пиксели без банер: COOKIE_CONSENT_ENABLED=0
COOKIE_CONSENT_ENABLED=1

# =============================================================================
# Analytics & Tracking
# =============================================================================
# Meta Pixel (Facebook Pixel) ID
# Намери го от: https://business.facebook.com/events_manager
META_PIXEL_ID=1522970765464792
# ISO 4217 — трябва да съвпада с валутата на цените в магазина (ViewContent / Purchase)
META_PIXEL_CURRENCY=EUR

# TikTok Pixel (Events Manager → Web Events → Pixel ID)
TIKTOK_PIXEL_ID=
# По подразбиране се ползва META_PIXEL_CURRENCY, ако не зададеш друго
TIKTOK_PIXEL_CURRENCY=EUR

# Google Analytics (GA4) ID
GOOGLE_ANALYTICS_ID=G-J2DV3RWZ8D

# =============================================================================
# Email Configuration
# =============================================================================
# Email backend (за production използвай SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server настройки
# За SendGrid:
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# За Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# За Mailgun:
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-mailgun-username
# EMAIL_HOST_PASSWORD=your-mailgun-password

# За development (Mailtrap):
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=your-mailtrap-user
# EMAIL_HOST_PASSWORD=your-mailtrap-password

# Email настройки
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=sales@marbaras.com
ADMIN_EMAIL=admin@marbaras.com

# =============================================================================
# Session & CSRF Cookies
# =============================================================================
# Session cookie age (секунди, default: 1209600 = 2 седмици)
SESSION_COOKIE_AGE=1209600
SESSION_SAVE_EVERY_REQUEST=False
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# CSRF cookie age (секунди, default: 31449600 = 1 година)
CSRF_COOKIE_AGE=31449600

# =============================================================================
# File Upload Settings
# =============================================================================
# Максимален размер на файл в паметта (байтове, default: 2.5MB)
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# =============================================================================
# Security Settings (Production Only)
# =============================================================================
# SSL redirect (True/False, default: True в production)
SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security) в секунди
SECURE_HSTS_SECONDS=31536000

# Reverse proxy support
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True

# =============================================================================
# Optional: Redis Cache (за performance)
# =============================================================================
# Ако искаш да използваш Redis за caching:
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Optional: Backup Settings
# =============================================================================
# Директория за backups (default: ./backups)
# BACKUP_DIR=./backups
